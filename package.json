    "@prisma/client": "7",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@trpc/tanstack-react-query": "^11.22.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
